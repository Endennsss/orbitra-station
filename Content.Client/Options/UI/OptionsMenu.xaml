<ui:FancyWindow xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls" xmlns="https://spacestation14.io"
            xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
            xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Lobby"
            Title="{Loc 'ui-options-title'}"
            SetSize="960 720" MinSize="320 200">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->
    <!-- Orbitra-Edit - компактный выбор раздела настроек. -->
    <Control> <!-- Orbitra-Edit: уведомление поверх содержимого, без пустого подвала. -->
    <BoxContainer Orientation="Vertical" SeparationOverride="12" Margin="12">
    <kit:OrbitraOptionButton Name="OrbitraTabSelect" />
    <kit:OrbitraEditorTabContainer Name="Tabs" Access="Public" VerticalExpand="True" TabsVisible="False">
        <tabs:MiscTab Name="MiscTab" />
        <tabs:GraphicsTab Name="GraphicsTab" />
        <tabs:KeyRebindTab Name="KeyRebindTab" />
        <tabs:AudioTab Name="AudioTab" />
        <tabs:AccessibilityTab Name="AccessibilityTab" />
        <tabs:AdminOptionsTab Name="AdminOptionsTab" />
    </kit:OrbitraEditorTabContainer>
    </BoxContainer>
    <kit:OrbitraNotification Name="OrbitraFeedback" VerticalAlignment="Bottom" Margin="12 0 12 64" />
    </Control>
</ui:FancyWindow>
