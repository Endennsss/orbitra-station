<ui1:EscapeMenu xmlns:orbitraKeyboard="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns="https://spacestation14.io"
                xmlns:changelog="clr-namespace:Content.Client.Changelog"
                xmlns:ui="clr-namespace:Content.Client.Voting.UI"
                xmlns:ui1="clr-namespace:Content.Client.Options.UI"
                xmlns:system="clr-namespace:System;assembly=System.Runtime"
                Title="{Loc 'ui-escape-title'}"
                Resizable="False" SetWidth="320">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->

    <!-- Orbitra-Edit - меню остаётся доступным при малой высоте окна. -->
    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" ReturnMeasure="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" MinWidth="224">
        <ui:VoteCallMenuButton />
        <Label Text="{Loc 'orbitra-menu-reference'}" StyleClasses="OrbitraLobbyMuted" /> <!-- Orbitra-Edit -->
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="RulesButton" Text="{Loc 'ui-escape-rules'}" StyleClasses="OpenLeft" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="GuidebookButton" Text="{Loc 'ui-escape-guidebook'}" StyleClasses="OpenBoth" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="WikiButton" Text="{Loc 'ui-escape-wiki'}" StyleClasses="OpenBoth" />
        <changelog:ChangelogButton Access="Public" Name="ChangelogButton" StyleClasses="OpenBoth"/>
        <orbitraKeyboard:OrbitraButton Access="Public" Name="FeedbackButton" Text="{Loc 'ui-escape-feedback'}" StyleClasses="OpenBoth"/>
        <orbitraKeyboard:OrbitraButton Access="Public" Name="BugReportButton" Text="{Loc 'ui-escape-bug-report'}" StyleClasses="OpenBoth"/>
        <orbitraKeyboard:OrbitraButton Access="Public" Name="AdminRemarksButton" Text="{Loc 'ui-escape-remarks'}" StyleClasses="OpenRight"/>
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="OptionsButton" Text="{Loc 'ui-escape-options'}" />
        <Label Text="{Loc 'orbitra-menu-exit'}" StyleClasses="OrbitraLobbyMuted" /> <!-- Orbitra-Edit -->
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="DisconnectButton" Text="{Loc 'ui-escape-disconnect'}" StyleClasses="OrbitraDangerButton" />
        <orbitraKeyboard:OrbitraButton Access="Public" Name="QuitButton" Text="{Loc 'ui-escape-quit'}" StyleClasses="OrbitraDangerButton" />
    </BoxContainer>
    </ScrollContainer>
</ui1:EscapeMenu>
