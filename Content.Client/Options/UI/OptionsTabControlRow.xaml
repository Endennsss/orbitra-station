<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <controls:StripeBack HasBottomEdge="False">
        <!-- Orbitra-Edit - длинная кнопка применения находится в отдельной строке -->
        <BoxContainer Orientation="Vertical" Margin="2" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="DefaultButton"
                    Text="{Loc 'ui-options-default'}"
                    TextAlign="Center"
                    HorizontalExpand="True" />

            <Button Name="ResetButton"
                    Text="{Loc 'ui-options-reset-all'}"
                    StyleClasses="OrbitraDangerButton" HorizontalExpand="True" /> <!-- Orbitra-Edit -->
            </BoxContainer>
            <Button Name="ApplyButton"
                    StyleClasses="OrbitraLobbyPrimary"
                    Text="{Loc 'ui-options-apply'}"
                    HorizontalExpand="True" />
        </BoxContainer>
    </controls:StripeBack>
</Control>
