<Control xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Lobby">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <kit:OrbitraSettingsForm Name="KeybindsContainer" Orientation="Vertical" Margin="8 8 8 8" MaxWidth="{x:Static kit:OrbitraUiMetrics.FormWidth}" HorizontalAlignment="Center" HorizontalExpand="True"> <!-- Orbitra-Edit: центрированная форма настроек. -->

                <!-- Keybind buttons are added here in the C# code -->

            </kit:OrbitraSettingsForm>
        </ScrollContainer>
        <controls:StripeBack HasBottomEdge="False" HasMargins="False">
            <kit:OrbitraAdaptiveRow Margin="8" SeparationOverride="8"> <!-- Orbitra-Edit -->
                <Control MinSize="8 0" />
                <RichTextLabel Text="{Loc 'ui-options-binds-explanation'}" StyleClasses="LabelSubText" HorizontalExpand="True" /> <!-- Orbitra-Edit -->
                <kit:OrbitraButton Name="ResetAllButton"
                        StyleClasses="OrbitraButtonDanger"
                        Text="{Loc 'ui-options-binds-reset-all'}"
                        HorizontalExpand="True"
                        HorizontalAlignment="Right" />
            </kit:OrbitraAdaptiveRow>
        </controls:StripeBack>
    </BoxContainer>
</Control>
