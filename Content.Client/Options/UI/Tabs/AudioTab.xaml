<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface"
         xmlns:voice="clr-namespace:Content.Client._Orbitra.VoiceChat"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->
    <BoxContainer Orientation="Vertical">
        <!-- Orbitra-Edit - высокие строки настроек прокручиваются внутри вкладки -->
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" ReserveScrollbarSpace="True">
            <kit:OrbitraSettingsForm Orientation="Vertical" Margin="8 8 8 8" MaxWidth="{x:Static kit:OrbitraUiMetrics.FormWidth}" HorizontalAlignment="Center" HorizontalExpand="True"> <!-- Orbitra-Edit: центрированная форма настроек. -->
            <Label Text="{Loc 'ui-options-volume-label'}"
                   StyleClasses="LabelKeyText"/>
            <BoxContainer Orientation="Vertical" Margin="0 3 0 0">
                <ui:OptionDropDown Name="DropDownAudioDevice" Title="{Loc 'ui-options-audio-device'}"
                                   Margin="0 0 0 8" />
                <!-- Orbitra-Edit - выбор микрофона для голосовой связи. -->
                <ui:OptionDropDown Name="DropDownVoiceInputDevice" Title="{Loc 'orbitra-voice-chat-input-device'}"
                                   Margin="0 0 0 8" />
                <ui:OptionSlider Name="SliderVoiceInputVolume" Title="{Loc 'orbitra-voice-chat-input-volume'}"
                                 Margin="0 0 0 8" />
                <voice:OrbitraMicrophoneTestControl Name="MicrophoneTest" Margin="0 0 0 8" />
                <RichTextLabel Text="{Loc 'orbitra-voice-chat-radio-help'}" Margin="0 0 0 8" />
                <ui:OptionSlider Name="SliderVoiceVolume" Title="{Loc 'orbitra-voice-chat-volume'}"
                                 Margin="0 0 0 8" />
                <kit:OrbitraCheckBox Name="VoiceEnabledCheckBox" Text="{Loc 'orbitra-voice-chat-enabled'}" />
                <ui:OptionSlider Name="SliderVolumeMaster" Title="{Loc 'ui-options-master-volume'}"
                                 Margin="0 0 0 8" />
                <ui:OptionSlider Name="SliderVolumeMidi" Title="{Loc 'ui-options-midi-volume'}" />
                <ui:OptionSlider Name="SliderVolumeAmbientMusic" Title="{Loc 'ui-options-ambient-music-volume'}" />
                <ui:OptionSlider Name="SliderVolumeAmbience" Title="{Loc 'ui-options-ambience-volume'}" />
                <ui:OptionSlider Name="SliderVolumeLobby" Title="{Loc 'ui-options-lobby-volume'}" />
                <ui:OptionSlider Name="SliderVolumeInterface" Title="{Loc 'ui-options-interface-volume'}" />
                <ui:OptionSlider Name="SliderMaxAmbienceSounds" Title="{Loc 'ui-options-ambience-max-sounds'}"
                                 Margin="0 0 0 8" />
                <kit:OrbitraCheckBox Name="LobbyMusicCheckBox" Text="{Loc 'ui-options-lobby-music'}" />
                <kit:OrbitraCheckBox Name="RestartSoundsCheckBox" Text="{Loc 'ui-options-restart-sounds'}" />
                <kit:OrbitraCheckBox Name="EventMusicCheckBox" Text="{Loc 'ui-options-event-music'}" />
                <kit:OrbitraCheckBox Name="AdminSoundsCheckBox" Text="{Loc 'ui-options-admin-sounds'}" />
                <kit:OrbitraCheckBox Name="BwoinkSoundCheckBox" Text="{Loc 'ui-options-bwoink-sound'}" />
                <kit:OrbitraCheckBox Name="AudioHrtfCheckBox" Text="{Loc 'ui-options-audio-hrtf'}" />
                <kit:OrbitraCheckBox Name="MuteUnfocusedCheckBox" Text="{Loc 'ui-options-mute-unfocused'}" />
            </BoxContainer>
            </kit:OrbitraSettingsForm>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
