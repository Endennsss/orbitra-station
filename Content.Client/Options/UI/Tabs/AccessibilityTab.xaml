<Control xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Lobby"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <kit:OrbitraSettingsForm Orientation="Vertical" Margin="8" MaxWidth="{x:Static kit:OrbitraUiMetrics.FormWidth}" HorizontalAlignment="Center" HorizontalExpand="True"> <!-- Orbitra-Edit: центрированная форма настроек. -->
                <Label Text="{Loc 'ui-options-accessibility-header-reduced-motion'}"
                       StyleClasses="LabelKeyText"/>
                <kit:OrbitraCheckBox Name="ReducedMotionCheckBox"
                    Text="{Loc 'ui-options-reduced-motion'}"
                    ToolTip="{Loc 'ui-options-reduced-motion-tooltip'}" />
                <!-- Orbitra-Edit: перенос настроек по ширине содержимого. -->
                <kit:OrbitraResponsiveGrid HorizontalExpand="True" Margin="8">
                    <kit:OrbitraCheckBox Name="DisableAiStaticCheckBox"
                        Text="{Loc 'ui-options-disable-ai-static'}"
                        ToolTip="{Loc 'ui-options-disable-ai-static-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableBlurryVisionCheckBox"
                        Text="{Loc 'ui-options-disable-blurry-vision'}"
                        ToolTip="{Loc 'ui-options-disable-blurry-vision-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableDrunkOverlayCheckBox"
                        Text="{Loc 'ui-options-disable-drunk-overlay'}"
                        ToolTip="{Loc 'ui-options-disable-drunk-overlay-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableFlashEffectCheckBox"
                        Text="{Loc 'ui-options-disable-flash-effect'}"
                        ToolTip="{Loc 'ui-options-disable-flash-effect-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableHeatDistortionCheckBox"
                        Text="{Loc 'ui-options-disable-heat-distortion'}"
                        ToolTip="{Loc 'ui-options-disable-heat-distortion-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableNightVisionNoiseCheckBox"
                        Text="{Loc 'ui-options-disable-nv-noise'}"
                        ToolTip="{Loc 'ui-options-disable-nv-noise-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableRainbowOverlayCheckBox"
                        Text="{Loc 'ui-options-disable-rainbow-overlay'}"
                        ToolTip="{Loc 'ui-options-disable-rainbow-overlay-tooltip'}" />
                    <kit:OrbitraCheckBox Name="DisableSinguloWarpCheckBox"
                        Text="{Loc 'ui-options-disable-singulo-warp'}"
                        ToolTip="{Loc 'ui-options-disable-singulo-warp-tooltip'}" />
                </kit:OrbitraResponsiveGrid>
                <Label Text="{Loc 'ui-options-accessibility-header-visuals'}"
                       StyleClasses="LabelKeyText"/>
                <kit:OrbitraCheckBox Name="EnableColorNameCheckBox" Text="{Loc 'ui-options-enable-color-name'}" />
                <kit:OrbitraCheckBox Name="ColorblindFriendlyCheckBox" Text="{Loc 'ui-options-colorblind-friendly'}" />
                <ui:OptionSlider Name="ScreenShakeIntensitySlider" Title="{Loc 'ui-options-screen-shake-intensity'}" />
                <ui:OptionSlider Name="ChatWindowOpacitySlider" Title="{Loc 'ui-options-chat-window-opacity'}" />
                <ui:OptionSlider Name="SpeechBubbleTextOpacitySlider" Title="{Loc 'ui-options-speech-bubble-text-opacity'}" />
                <ui:OptionSlider Name="SpeechBubbleSpeakerOpacitySlider" Title="{Loc 'ui-options-speech-bubble-speaker-opacity'}" />
                <ui:OptionSlider Name="SpeechBubbleBackgroundOpacitySlider" Title="{Loc 'ui-options-speech-bubble-background-opacity'}" />
                <kit:OrbitraCheckBox Name="AutoFillHighlightsCheckBox" Text="{Loc 'ui-options-auto-fill-highlights'}" />
                <ui:OptionColorSlider Name="HighlightsColorSlider"
                    Title="{Loc 'ui-options-highlights-color'}"
                    Example="{Loc 'ui-options-highlights-color-example'}"/>
                <Label Text="{Loc 'ui-options-accessibility-header-content'}"
                       StyleClasses="LabelKeyText"/>
                <kit:OrbitraCheckBox Name="CensorNudityCheckBox" Text="{Loc 'ui-options-censor-nudity'}" />
            </kit:OrbitraSettingsForm>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
