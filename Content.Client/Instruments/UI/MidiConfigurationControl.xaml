<BoxContainer xmlns="https://spacestation14.io"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Stylesheets"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical">
    <RichTextLabel Name="Header"
                   Access="Public"
                   StyleClasses="LabelKeyText"
                   Margin="10 0 0 0"/>
    <PanelContainer Name="Panel"
                    Access="Public"
                    Margin="0 0 0 10">
        <PanelContainer.PanelOverride>
            <!-- Orbitra-Edit - общий серый стиль. -->
            <gfx:StyleBoxFlat BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBorder}"
                              BorderThickness="2"/>
        </PanelContainer.PanelOverride>
    </PanelContainer>
</BoxContainer>
