<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Client\</OutputPath>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <WarningsAsErrors>RA0032;nullable;CS8785</WarningsAsErrors>
    <!-- Orbitra-Edit: production packaging needs the managed voice codec assembly. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <!-- Orbitra added start - отдельный dev-хост запускает сервер вне песочницы игрового кода. -->
  <ItemGroup Condition="'$(FullRelease)' != 'True'">
    <ProjectReference Include="../Tools/_Orbitra/DevHost/Orbitra.DevHost.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath" />
  </ItemGroup>
  <Target Name="OrbitraInstallDevHost" AfterTargets="Build" Condition="'$(FullRelease)' != 'True'">
    <ItemGroup>
      <OrbitraHostFiles Include="../bin/Orbitra.DevHost/Orbitra.DevHost.dll;../bin/Orbitra.DevHost/Orbitra.DevHost.deps.json;../bin/Orbitra.DevHost/Orbitra.DevHost.runtimeconfig.json" />
      <!-- Orbitra added start - доверенный хост загружает голосовой backend до sandboxed content. -->
      <OrbitraVoiceBackendFiles Include="../bin/Orbitra.VoiceChatBackend/Orbitra.VoiceChatBackend.dll;../bin/Orbitra.VoiceChatBackend/Orbitra.VoiceChatBackend.deps.json" />
      <!-- Orbitra added end -->
    </ItemGroup>
    <Copy SourceFiles="@(OrbitraHostFiles)" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="@(OrbitraVoiceBackendFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../bin/Orbitra.DevHost/Orbitra.DevHost.exe" DestinationFiles="$(TargetDir)Content.Client.exe" Condition="'$(OS)' == 'Windows_NT'" />
    <Copy SourceFiles="../bin/Orbitra.DevHost/Orbitra.DevHost" DestinationFiles="$(TargetDir)Content.Client" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>
  <!-- Orbitra added end -->
  <ItemGroup>
    <!-- Orbitra added start - доверенный backend скрывает native/audio зависимости от sandboxed content. -->
    <ProjectReference Include="../Tools/_Orbitra/VoiceChatBackend/Orbitra.VoiceChatBackend.csproj" />
    <!-- Orbitra added end -->
    <PackageReference Include="Nett" />
    <!-- Orbitra added start - кодек должен попасть в production content pack вместе с backend. -->
    <PackageReference Include="Concentus" />
    <!-- Orbitra added end -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Pidgin" />
    <PackageReference Include="Robust.Shared.AuthLib" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Lidgren.props" />
  <Import Project="..\RobustToolbox\Imports\Client.props" />
  <Import Project="..\RobustToolbox\Imports\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\Content.Shared\Content.Shared.csproj" />
  </ItemGroup>
  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\XamlIL.targets" />
  <Import Project="..\RobustToolbox\MSBuild\Robust.EntitySystemSubscriptionsGenerator.targets" />
</Project>
