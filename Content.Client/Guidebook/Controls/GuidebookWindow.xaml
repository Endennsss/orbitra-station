<controls:FancyWindow xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns="https://spacestation14.io"
                xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
                xmlns:fancyTree="clr-namespace:Content.Client.UserInterface.Controls.FancyTree"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Lobby"
                SetSize="900 700"
                MinSize="100 200"
                Resizable="True"
                Title="{Loc 'guidebook-window-title'}">
    <!-- Orbitra-Edit - компактная навигация не сжимает статью. -->
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
    <Button Name="OrbitraSections" Text="{Loc 'orbitra-guide-sections'}" StyleClasses="OrbitraButtonGhost" Visible="False" />
    <kit:OrbitraGuideSplitContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Name="Split"> <!-- Orbitra-Edit -->
        <!-- Guide select -->
        <BoxContainer Orientation="Horizontal" Name="TreeBox">
            <BoxContainer Name="OrbitraNavigation" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8"> <!-- Orbitra-Edit -->
            <LineEdit Name="OrbitraArticleSearch" PlaceHolder="{Loc 'orbitra-guide-search-articles'}" HorizontalExpand="True" />
            <fancyTree:FancyTree Name="Tree" VerticalExpand="True" HorizontalExpand="True" Access="Public"/>
            <ScrollContainer Name="OrbitraResultsScroll" Visible="False" HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Name="OrbitraSearchResults" Orientation="Vertical" SeparationOverride="4" />
            </ScrollContainer>
            </BoxContainer>
            <cc:VSeparator StyleClasses="LowDivider" Margin="0 -2"/>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <WrapContainer Name="OrbitraBreadcrumbs" SeparationOverride="4" CrossSeparationOverride="4" /> <!-- Orbitra-Edit -->
            <fancyTree:FancyTree Name="TableOfContents" HorizontalExpand="True"/>
            <BoxContainer Name="SearchContainer" Visible="False" HorizontalExpand="True">
                <LineEdit
                    Name="SearchBar"
                    PlaceHolder="{Loc 'guidebook-filter-placeholder-text'}"
                    HorizontalExpand="True"
                    Margin="0 5 10 5">
                </LineEdit>
            </BoxContainer>
            <BoxContainer Access="Internal" Name="ReturnContainer" Orientation="Horizontal" HorizontalAlignment="Right" Visible="False">
                <Button Name="HomeButton" Text="{Loc 'ui-rules-button-home'}" Margin="0 0 10 0"/>
            </BoxContainer>
            <ScrollContainer Name="Scroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <Control>
                    <BoxContainer Orientation="Vertical" Name="EntryContainer" Margin="5 5 5 5" Visible="False">
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" Name="Placeholder" Margin="5 5 5 5">
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'guidebook-placeholder-text'}"/>
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'guidebook-placeholder-text-2'}"/>
                    </BoxContainer>
                </Control>
            </ScrollContainer>
        </BoxContainer>
    </kit:OrbitraGuideSplitContainer>
    </BoxContainer>
</controls:FancyWindow>
