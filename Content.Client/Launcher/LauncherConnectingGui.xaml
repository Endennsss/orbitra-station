<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:parallax="clr-namespace:Content.Client.Parallax"
         xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface">
    <!-- Orbitra edit start - экран подключения использует общую тему меню. -->
    <parallax:ParallaxControl Name="BackgroundParallax" SpeedX="5" SpeedY="20" ScaleX="3" ScaleY="3" />
    <ScrollContainer HorizontalAlignment="Center" VerticalAlignment="Center"
                     HScrollEnabled="False" ReturnMeasure="True">
        <BoxContainer Name="ConnectionCard" Orientation="Vertical" Margin="16" SeparationOverride="12">
            <BoxContainer HorizontalAlignment="Center" SeparationOverride="12">
                <TextureRect SetSize="72 72" Stretch="KeepAspectCentered" StyleClasses="OrbitraBrandLogo" />
                <Label Text="Orbitra" VerticalAlignment="Center" StyleClasses="OrbitraLobbyTitle" />
            </BoxContainer>

            <PanelContainer StyleClasses="OrbitraLobbyPanel">
                <BoxContainer Orientation="Vertical" SeparationOverride="16">
                    <BoxContainer Orientation="Vertical" Name="ConnectingStatus" SeparationOverride="8">
                        <Label Text="{Loc 'connecting-in-progress'}" StyleClasses="OrbitraLobbyHeading" />
                        <Label Name="ConnectStatus" StyleClasses="OrbitraLobbyMuted" />
                    </BoxContainer>

                    <BoxContainer Orientation="Vertical" Name="ConnectFail" Visible="False" SeparationOverride="12">
                        <RichTextLabel Name="ConnectFailReason" />
                        <kit:OrbitraAdaptiveRow Breakpoint="420" SeparationOverride="8">
                            <kit:OrbitraButton Name="RetryButton" Text="{Loc 'connecting-retry'}"
                                               StyleClasses="OrbitraButtonPrimary" HorizontalExpand="True" />
                            <kit:OrbitraButton Name="CopyButton" Text="{Loc 'connecting-copy'}"
                                               StyleClasses="OrbitraButtonSecondary" HorizontalExpand="True" />
                        </kit:OrbitraAdaptiveRow>
                    </BoxContainer>

                    <BoxContainer Orientation="Vertical" Name="Disconnected" Visible="False" SeparationOverride="12">
                        <Label Text="{Loc 'connecting-disconnected'}" StyleClasses="OrbitraLobbyHeading" />
                        <RichTextLabel Name="DisconnectReason" />
                        <kit:OrbitraAdaptiveRow Breakpoint="420" SeparationOverride="8">
                            <kit:OrbitraButton Name="ReconnectButton" Text="{Loc 'connecting-reconnect'}"
                                               StyleClasses="OrbitraButtonPrimary" HorizontalExpand="True" />
                            <kit:OrbitraButton Name="CopyButtonDisconnected" Text="{Loc 'connecting-copy'}"
                                               StyleClasses="OrbitraButtonSecondary" HorizontalExpand="True" />
                        </kit:OrbitraAdaptiveRow>
                    </BoxContainer>

                    <Label Name="ConnectingAddress" StyleClasses="OrbitraLobbyMuted" ClipText="True" Visible="False" />
                    <kit:OrbitraButton Name="ExitButton" Text="{Loc 'connecting-exit'}"
                                       StyleClasses="OrbitraButtonGhost" HorizontalAlignment="Right" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer Name="LoginTips" StyleClasses="OrbitraLobbyPanel">
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <Label Name="LoginTipTitle" StyleClasses="OrbitraLobbyHeading" />
                    <RichTextLabel Name="LoginTip" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </ScrollContainer>
    <!-- Orbitra edit end -->
</Control>
