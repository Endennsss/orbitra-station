<pda:PdaWindow  xmlns="https://spacestation14.io"
                xmlns:pda="clr-namespace:Content.Client.PDA"
                xmlns:case="clr-namespace:Content.Client._Orbitra.Pda"
                xmlns:ui="clr-namespace:Content.Client._Orbitra.UserInterface"
                MouseFilter="Stop">
    <!-- Orbitra edit start - обод со спрайта и общая шапка, примыкающая к экрану. -->
    <PanelContainer Name="Background" Access="Public" StyleClasses="PdaBackgroundRect" MouseFilter="Ignore"/>
    <case:OrbitraPdaTrim Name="CaseTrim" Access="Public" MouseFilter="Ignore"/>
    <BoxContainer Name="CaseInterior" Orientation="Vertical">
        <PanelContainer Name="Header" StyleClasses="OrbitraWindowHeader">
            <BoxContainer Orientation="Horizontal" Margin="12 0 4 0">
                <Label Text="{Loc 'comp-pda-ui-menu-title'}" StyleClasses="FancyWindowTitle OrbitraWindowTitle"
                       VerticalAlignment="Center" HorizontalExpand="True"/>
                <ui:OrbitraWindowCloseButton Name="CloseButton" VerticalAlignment="Center"/>
            </BoxContainer>
        </PanelContainer>
        <BoxContainer Access="Public" Name="ContentsContainer" Orientation="Vertical"
                      VerticalExpand="True"/>
    </BoxContainer>
    <!-- Orbitra edit end -->
</pda:PdaWindow>
