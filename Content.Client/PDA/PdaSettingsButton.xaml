<pda:PdaSettingsButton xmlns="https://spacestation14.io"
                       xmlns:pda="clr-namespace:Content.Client.PDA"
                       StyleClasses="button OrbitraOptionRow"
                       HorizontalExpand="True"
                       MinHeight="48">
    <!-- Orbitra edit start - описание переносится по ширине экрана. -->
    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="3" MouseFilter="Ignore">
        <Label Name="OptionName" ClipText="True" MouseFilter="Ignore"/>
        <RichTextLabel Name="OptionDescription" MouseFilter="Ignore"/>
    </BoxContainer>
    <!-- Orbitra edit end -->
</pda:PdaSettingsButton>
