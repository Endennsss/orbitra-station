<ContainerButton HorizontalExpand="True" MinHeight="44" Margin="4 3" StyleClasses="button OrbitraOptionRow"
                 xmlns="https://spacestation14.io">
    <!-- Orbitra edit start - имя, значок и действие в одной строке. -->
    <BoxContainer Orientation="Horizontal" Margin="8 4" SeparationOverride="6">
        <AnimatedTextureRect Name="Icon" SetSize="36 36" VerticalAlignment="Center" MouseFilter="Ignore"/>
        <Label Name="ProgramName" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" MouseFilter="Ignore"/>
        <Button Name="InstallButton" StyleClasses="button OrbitraButtonSecondary" Visible="False" VerticalAlignment="Center"/>
    </BoxContainer>
    <!-- Orbitra edit end -->
</ContainerButton>
