<PanelContainer
    xmlns="https://spacestation14.io"
    xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    HorizontalExpand="True"
    StyleClasses="BackgroundPanel">

    <!-- Main Container -->
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  SeparationOverride="6"> <!-- Orbitra-Edit - карточка укладывается в ширину списка. -->

        <BoxContainer Orientation="Vertical">
            <Control>
                <PanelContainer StyleClasses="WindowHeadingBackground" />

                <BoxContainer Margin="6">
                    <RichTextLabel Name="Title" Access="Public" StyleClasses="LabelKeyText"/> <!-- Orbitra-Edit - длинный заголовок переносится. -->
                </BoxContainer>
            </Control>

            <controls:Separator Name="Stride"
                Access="Public"
                StyleClasses="LowDivider"/>
        </BoxContainer>

        <!-- Info -->
        <BoxContainer>
            <TextureRect Name="Icon"
                         Access="Public"
                         MinSize="32 32"
                         Margin="4"
                         Stretch="KeepAspectCentered"
                         RectClipContent="True"
                         VerticalAlignment="Center"/>

            <controls:Separator StyleClasses="LowDivider" Margin="4 0" Orientation="Vertical" MinHeight="2"/>

            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True">

                <RichTextLabel Name="ProductName"
                       Access="Public"
                       HorizontalExpand="True"
                       VerticalExpand="True"
                       StyleClasses="LabelSubText" />

                <RichTextLabel Name="Description" Access="Public" StyleClasses="OrbitraLobbyMuted"/> <!-- Orbitra-Edit - причина переносится на новую строку. -->
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical">
            <controls:Separator StyleClasses="LowDivider"/>

            <!-- Orbitra edit start - действия переносятся, если подписи не помещаются в один ряд. -->
            <kit:OrbitraFlowGrid Margin="6" HSeparationOverride="6" VSeparationOverride="6">
                <Button Name="Approve"
                        Access="Public"
                        Text="{Loc 'cargo-console-menu-order-row-button-approve'}"
                        StyleClasses="OpenRight"
                        HorizontalExpand="True"/>

                <Button Name="Cancel"
                        Access="Public"
                        Text="{Loc 'cargo-console-menu-order-row-button-cancel'}"
                        StyleClasses="OpenLeft"
                        HorizontalExpand="True" />
            </kit:OrbitraFlowGrid>
            <!-- Orbitra edit end -->
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
