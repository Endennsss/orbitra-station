<BoxContainer xmlns="https://spacestation14.io"
              xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
              xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface"
              Margin="10 10 10 0"
              HorizontalExpand="True"
              Visible="True">
    <PanelContainer StyleClasses="BackgroundPanel" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True">
            <!-- Orbitra edit start - манифест и действия получают полную ширину карточки. -->
            <BoxContainer SeparationOverride="6">
                <RichTextLabel Name="RewardLabel" HorizontalExpand="True"/>
                <RichTextLabel Name="IdLabel" HorizontalAlignment="Right"/>
            </BoxContainer>
            <RichTextLabel Name="ManifestLabel"/>
            <customControls:HSeparator Margin="5 10 5 10"/>
            <RichTextLabel Name="DescriptionLabel"/>
            <kit:OrbitraFlowGrid Margin="0 8 0 0" HSeparationOverride="6" VSeparationOverride="6">
                <Button Name="PrintButton" Text="{Loc 'bounty-console-label-button-text'}" HorizontalExpand="True"/>
                <Button Name="SkipButton" Text="{Loc 'bounty-console-skip-button-text'}" HorizontalExpand="True"/>
            </kit:OrbitraFlowGrid>
            <!-- Orbitra edit end -->
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
