<BoxContainer xmlns="https://spacestation14.io"
              xmlns:c="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:o="clr-namespace:Content.Client._Orbitra.UserInterface"
              xmlns:med="clr-namespace:Content.Client._Orbitra.Surgery"
              Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" SeparationOverride="6">
    <!-- Orbitra edit start -->
    <RichTextLabel Name="NoPatientDataText" Text="{Loc 'health-analyzer-window-no-patient-data-text'}"/>
    <PanelContainer Name="Summary" StyleClasses="OrbitraWindowSurface" Visible="False">
        <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="6">
            <BoxContainer SeparationOverride="8">
                <SpriteView Name="SpriteView" OverrideDirection="South" Scale="1.5 1.5" SetSize="48 48"/>
                <o:OrbitraAdaptiveRow HorizontalExpand="True" Breakpoint="275" VerticalAlignment="Center" SeparationOverride="4">
                    <BoxContainer HorizontalExpand="True" Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="0">
                        <RichTextLabel Name="PatientName" StyleClasses="FontLarge" HorizontalExpand="True"/>
                        <RichTextLabel Name="SpeciesLabel" StyleClasses="FontSmall" HorizontalExpand="True"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center" MaxWidth="140" SeparationOverride="0">
                        <RichTextLabel Name="StatusLabel"/>
                        <RichTextLabel Name="ScanModeLabel" StyleClasses="FontSmall"/>
                    </BoxContainer>
                </o:OrbitraAdaptiveRow>
            </BoxContainer>
            <c:Separator StyleClasses="LowDivider"/>
            <BoxContainer SeparationOverride="10">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
                    <Label StyleClasses="LabelSubText" Text="{Loc 'orbitra-analyzer-blood'}"/>
                    <Label Name="BloodLabel" StyleClasses="LabelHeading"/>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
                    <Label StyleClasses="LabelSubText" Text="{Loc 'orbitra-analyzer-temperature'}"/>
                    <Label Name="TemperatureLabel" MouseFilter="Pass" StyleClasses="LabelHeading"/>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
                    <Label StyleClasses="LabelSubText" Text="{Loc 'orbitra-analyzer-damage'}"/>
                    <Label Name="DamageLabel" StyleClasses="LabelHeading"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
    <PanelContainer Name="AlertsPanel" Visible="False" StyleClasses="OrbitraNotification OrbitraNotificationError">
        <RichTextLabel Name="AlertsText" HorizontalExpand="True" Margin="4 0"/>
    </PanelContainer>
    <ScrollContainer Name="DetailsScroll" Visible="False" HScrollEnabled="False" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
            <med:OrbitraAnalyzerAnatomy Name="AnalyzerAnatomy" Visible="False"/>
            <o:OrbitraButton Name="DamageToggle" StyleClasses="OrbitraButtonSecondary" ToggleMode="True"
                             HorizontalExpand="True" Visible="False" Text="{Loc 'orbitra-analyzer-expand-damage'}"/>
            <BoxContainer Name="GroupsContainer" Visible="False" Orientation="Vertical" Margin="8 0" SeparationOverride="6"/>
        </BoxContainer>
    </ScrollContainer>
    <!-- Orbitra edit end -->
</BoxContainer>
