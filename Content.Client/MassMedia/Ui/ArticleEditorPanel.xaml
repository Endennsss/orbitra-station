<Control xmlns="https://spacestation14.io" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Stylesheets"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface"
         MouseFilter="Stop">
    <PanelContainer StyleClasses="BackgroundPanel"/> <!-- Orbitra-Edit - редактор размещён внутри окна. -->
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBackground}" BorderThickness="0 0 0 3"/>
        </PanelContainer.PanelOverride>
    </PanelContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <Control Margin="0 0 1 0">
            <PanelContainer StyleClasses="WindowHeadingBackground" />
            <BoxContainer Margin="4 2 8 0" Orientation="Horizontal">
                <Label Name="Title" Text="{Loc news-write-ui-new-article}"
                       HorizontalExpand="True" VAlign="Center" StyleClasses="FancyWindowTitle" />
            </BoxContainer>
        </Control>
        <controls:Separator StyleClasses="LowDivider" Margin="0 0 1 0"/>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc news-write-ui-article-name-label}" Margin="17 10 0 9" VerticalAlignment="Center"/>
            <!-- Orbitra edit start - ширина поля следует за шириной редактора. -->
            <LineEdit Name="TitleField" Margin="6 10 0 9" HorizontalExpand="True" MinHeight="23" Access="Public"/>
            <Label Name="RichTextInfoLabel" Text="?" MouseFilter="Pass" Margin="14 0" VerticalAlignment="Center" StyleClasses="LabelWeak"/>
            <!-- Orbitra edit end -->
        </BoxContainer>
        <Control Name="TextEditPanel" VerticalExpand="True" Margin="11 0 11 0">
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="{x:Static orbitra:OrbitraPalettes.PanelInset}" BorderThickness="1" BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBorder}"/>
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <TextEdit Name="ContentField" Margin="0 1" Access="Public"/>
        </Control>
        <Control Name="PreviewPanel" Visible="False" VerticalExpand="True" Margin="11 0 11 0">
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BorderThickness="1" BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBorder}"/>
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <ScrollContainer HScrollEnabled="True">
                <RichTextLabel Name="PreviewLabel" VerticalAlignment="Top" Margin="9 3" MaxWidth="360"/>
            </ScrollContainer>
        </Control>
        <!-- Orbitra edit start - размеры кнопок зависят от перевода и доступной ширины. -->
        <kit:OrbitraFlowGrid Margin="12 5 12 8" HSeparationOverride="6" VSeparationOverride="6">
            <Button Name="ButtonCancel" MinHeight="32" HorizontalExpand="True"
                    StyleClasses="negative" Text="{Loc news-write-ui-cancel-text}"/>
            <Button Name="ButtonSaveDraft" MinHeight="32" HorizontalExpand="True" Text="{Loc news-write-ui-save-text}"/>
            <Button Name="ButtonPreview" MinHeight="32" HorizontalExpand="True" Text="{Loc news-write-ui-preview-text}"/>
            <Button Name="ButtonPublish" MinHeight="32" HorizontalExpand="True"
                    StyleClasses="positive" Text="{Loc news-write-ui-publish-text}" Access="Public"/>
        </kit:OrbitraFlowGrid>
        <!-- Orbitra edit end -->
    </BoxContainer>
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderThickness="2 0 0 0" BorderColor="{x:Static orbitra:OrbitraPalettes.PanelInset}"/> <!-- Orbitra-Edit -->
        </PanelContainer.PanelOverride>
    </PanelContainer>
    <PanelContainer HorizontalAlignment="Left" VerticalAlignment="Top" SetHeight="27" SetWidth="2">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBackground}" BorderThickness="0 0 0 2"/> <!-- Orbitra-Edit -->
        </PanelContainer.PanelOverride>
    </PanelContainer>
    <PanelContainer HorizontalAlignment="Left" VerticalAlignment="Top" SetHeight="25" SetWidth="2">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="{x:Static orbitra:OrbitraPalettes.PanelInset}"/> <!-- Orbitra-Edit -->
        </PanelContainer.PanelOverride>
    </PanelContainer>
</Control>
