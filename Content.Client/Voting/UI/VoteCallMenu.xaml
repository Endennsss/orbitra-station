<ui:VoteCallMenu xmlns="https://spacestation14.io"
                 xmlns:ui="clr-namespace:Content.Client.Voting.UI"
                 xmlns:kit="clr-namespace:Content.Client._Orbitra.UserInterface"
                 Title="{Loc 'ui-vote-create-title'}" SetSize="440 280" MinSize="250 190">
    <!-- Orbitra edit start - общая рамка и кнопка создания вне прокрутки. -->
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                <kit:OrbitraOptionButton Name="VoteTypeButton" HorizontalExpand="True" />
                <BoxContainer Name="VoteOptionsButtonContainer" Orientation="Vertical" SeparationOverride="8" />
                <kit:OrbitraButton Name="FollowButton" Text="{Loc 'ui-vote-follow-button'}"
                                   StyleClasses="OrbitraButtonSecondary" Visible="False" />
                <RichTextLabel Name="VoteNotTrustedLabel" Visible="False" />
                <RichTextLabel Name="VoteWarningLabel" Text="{Loc 'ui-vote-abuse-warning'}" Visible="False" />
                <RichTextLabel Name="VoteTypeTimeoutLabel" StyleClasses="OrbitraLobbyMuted" Visible="False" />
            </BoxContainer>
        </ScrollContainer>
        <kit:OrbitraButton Name="CreateButton" Text="{Loc 'ui-vote-create-button'}"
                           StyleClasses="OrbitraButtonPrimary" Disabled="True" />
        <Label Name="VoteFooter" StyleClasses="OrbitraLobbyMuted" Text="{Loc 'ui-vote-fluff'}" ClipText="True" />
    </BoxContainer>
    <!-- Orbitra edit end -->
</ui:VoteCallMenu>
