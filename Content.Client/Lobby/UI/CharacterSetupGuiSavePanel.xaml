<ui:FancyWindow xmlns="https://spacestation14.io" xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
            Title="{Loc 'orbitra-editor-save-title'}"
            Resizable="False">

    <!-- Orbitra-Edit - единое оформление и вертикальные действия без переполнения узкого окна. -->
    <BoxContainer Orientation="Vertical" SeparationOverride="8" MinSize="280 40" Margin="12">
        <Button Name="SaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-save'}" StyleClasses="OrbitraButtonPrimary"/>
        <Button Name="NoSaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-nosave'}" StyleClasses="OrbitraButtonSecondary"/>
        <Button Name="CancelButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-cancel'}" StyleClasses="OrbitraButtonSecondary"/>
    </BoxContainer>
</ui:FancyWindow>
