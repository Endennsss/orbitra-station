<ui:FancyWindow xmlns:orbitraKeyboard="clr-namespace:Content.Client._Orbitra.UserInterface" xmlns="https://spacestation14.io" xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
            Title="{Loc 'orbitra-editor-save-title'}"
            Resizable="False">
    <!-- Orbitra-Edit - клавиатурные действия используют штатные обработчики. -->

    <!-- Orbitra-Edit - единое оформление и вертикальные действия без переполнения узкого окна. -->
    <BoxContainer Orientation="Vertical" SeparationOverride="8" MinSize="280 40" Margin="12">
        <orbitraKeyboard:OrbitraButton Name="SaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-save'}" StyleClasses="OrbitraButtonPrimary"/>
        <orbitraKeyboard:OrbitraButton Name="NoSaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-nosave'}" StyleClasses="OrbitraButtonSecondary"/>
        <orbitraKeyboard:OrbitraButton Name="CancelButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-cancel'}" StyleClasses="OrbitraButtonSecondary"/>
    </BoxContainer>
</ui:FancyWindow>
