<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:orbitra="clr-namespace:Content.Client._Orbitra.UserInterface"
                      Title="{Loc 'orbitra-xeno-processor-title'}" MinSize="360 320" SetSize="520 440" StyleClasses="OrbitraEditorLayout">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Name="HeaderPanel" StyleClasses="OrbitraWindowHeader">
            <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="4">
                <RichTextLabel Name="Status" Access="Public" HorizontalExpand="True"/>
            </BoxContainer>
        </PanelContainer>
        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" ReserveScrollbarSpace="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10">
                <Label Name="EmptyLabel" Access="Public" Text="{Loc 'orbitra-xeno-input-empty'}" ClipText="True" StyleClasses="LabelHeading"/>
                <RichTextLabel Name="EmptyInstructions" Text="{Loc 'orbitra-xeno-processor-instructions'}" HorizontalExpand="True"/>
                <PanelContainer Name="InputPanel" StyleClasses="OrbitraWindowSurface" Access="Public" Visible="False">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="10" HorizontalExpand="True">
                        <BoxContainer SeparationOverride="10">
                            <EntityPrototypeView Name="Portrait" SetSize="72 72"/>
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                <Label Name="InputName" Access="Public" StyleClasses="LabelHeading" ClipText="True"/>
                                <Label Name="InputBreed" ClipText="True"/>
                                <Label Name="InputCondition" ClipText="True"/>
                            </BoxContainer>
                        </BoxContainer>
                        <BoxContainer SeparationOverride="10">
                            <TextureRect Name="ExtractIcon" SetSize="40 40" Stretch="KeepAspectCentered"/>
                            <Label Name="ExpectedYield" Access="Public" VerticalAlignment="Center" HorizontalExpand="True" ClipText="True"/>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Name="ProgressPanel" Orientation="Vertical" SeparationOverride="6" Visible="False">
                    <ProgressBar Name="Progress" Access="Public" MinValue="0" MaxValue="1" MinHeight="18" HorizontalExpand="True"/>
                    <Label Name="Remaining" HorizontalAlignment="Center"/>
                </BoxContainer>
                <RichTextLabel Name="ActionHint" Access="Public" HorizontalExpand="True" Visible="False"/>
            </BoxContainer>
        </ScrollContainer>
        <BoxContainer Name="ActionButtons" SeparationOverride="8">
            <orbitra:OrbitraButton Name="ProcessButton" Access="Public" Text="{Loc 'orbitra-xeno-process'}" HorizontalExpand="True" Disabled="True"/>
            <orbitra:OrbitraButton Name="EjectButton" Access="Public" Text="{Loc 'orbitra-xeno-eject'}" HorizontalExpand="True" Disabled="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
