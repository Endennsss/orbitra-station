<Control xmlns="https://spacestation14.io" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:orbitra="clr-namespace:Content.Client._Orbitra.Stylesheets"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         MaxWidth="400">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat 
                BorderThickness="2" 
                BorderColor="{x:Static orbitra:OrbitraPalettes.PanelBorder}"
                BackgroundColor="{x:Static orbitra:OrbitraPalettes.PanelBackground}"
            />
        </PanelContainer.PanelOverride>
        <BoxContainer 
            Orientation="Vertical"
            RectClipContent="True"
            Margin="4">
            <RichTextLabel Name="RecipeTooltipLabel" HorizontalExpand="True" />
        </BoxContainer>
    </PanelContainer>
</Control>
