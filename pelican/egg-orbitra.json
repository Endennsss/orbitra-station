{
  "meta": {
    "version": "PTDL_v2"
  },
  "exported_at": "2026-10-03T00:00:00+00:00",
  "name": "Orbitra Station",
  "author": "orbitra@example.invalid",
  "description": "Production Space Station 14 server for the Orbitra fork.",
  "features": [
    "pid_limit"
  ],
  "docker_images": {
    "Orbitra Station": "ghcr.io/endennsss/orbitra-station:latest"
  },
  "file_denylist": [],
  "startup": "./Robust.Server --config-file config.toml --data-dir data",
  "config": {
    "files": "{}",
    "startup": "{}",
    "logs": "{}",
    "stop": "^SIGINT"
  },
  "scripts": {
    "installation": {
      "container": "ghcr.io/pelican-eggs/installers:debian",
      "entrypoint": "bash",
      "script": "#!/bin/bash\nset -euo pipefail\ncd /mnt/server\nmkdir -p data logs saves\nprintf '%s\\n' 'Orbitra files will be synchronized by the runtime image on first start.'\n"
    }
  },
  "variables": [
    {
      "name": "Server port",
      "description": "The TCP and UDP port assigned to this Pelican server.",
      "env_variable": "SERVER_PORT",
      "default_value": "1212",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|between:1,65535",
      "field_type": "text"
    },
    {
      "name": "Server name",
      "description": "Name shown in the launcher and in the server list.",
      "env_variable": "SERVER_NAME",
      "default_value": "Orbitra Station",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:80",
      "field_type": "text"
    },
    {
      "name": "Server description",
      "description": "Description shown in the launcher.",
      "env_variable": "SERVER_DESC",
      "default_value": "Русскоязычный сервер Orbitra Station",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:255",
      "field_type": "text"
    }
  ]
}
