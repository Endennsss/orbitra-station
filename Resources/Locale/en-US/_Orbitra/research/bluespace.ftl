research-technology-orbitra-bluespace-field = Bluespace Field Research
    .suffix = Orbitra
orbitra-research-technology-orbitra-bluespace-field-description = Powered research probers and suppressors for studying and controlling the station's shared bluespace background.
research-technology-orbitra-bluespace-harvesting = Bluespace Harvesting
    .suffix = Orbitra
orbitra-research-technology-orbitra-bluespace-harvesting-description = A high-voltage harvester which recovers materials and supplies at the cost of power and station-wide instability.

ent-OrbitraBluespaceFieldMachineBase = bluespace field device
    .desc = A device for studying the bluespace field.
    .suffix = Orbitra
ent-OrbitraBluespaceProber = bluespace research prober
    .desc = Studies the local bluespace field to generate research points. Requires a linked research server and raises the station's bluespace background.
    .suffix = Orbitra
ent-OrbitraBluespaceSuppressor = bluespace background suppressor
    .desc = Uses power to stabilize the station's shared bluespace field. Remains usable during a critical background event.
    .suffix = Orbitra
ent-OrbitraBluespaceHarvester = bluespace harvester
    .desc = A high-voltage installation which converts energy into recovered materials and supplies. Overdrive increases both power demand and bluespace instability.
    .suffix = Orbitra
ent-OrbitraBluespaceProberBoard = bluespace prober board
    .desc = A machine circuit board for a bluespace research prober.
    .suffix = Orbitra
ent-OrbitraBluespaceSuppressorBoard = bluespace suppressor board
    .desc = A machine circuit board for a bluespace background suppressor.
    .suffix = Orbitra
ent-OrbitraBluespaceHarvesterBoard = bluespace harvester board
    .desc = A machine circuit board for a high-voltage bluespace harvester.
    .suffix = Orbitra
ent-OrbitraBluespaceRift = bluespace rift
    .desc = A short-lived breach in the local bluespace field.
    .suffix = Orbitra

