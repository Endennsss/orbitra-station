light_mode unshaded;
blend_mode none;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

highp float luminance(highp vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void fragment() {
    lowp vec4 source = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float amount = clamp(strength, 0.0, 1.0);
    highp vec3 original = max(source.rgb, vec3(0.0));
    highp float brightness = luminance(original);

    // Сильнее затемняем тени, но оставляем яркие лампы и аварийные индикаторы читаемыми.
    highp float shadows = 1.0 - smoothstep(0.08, 0.72, brightness);
    highp float highlights = smoothstep(0.58, 0.94, brightness);

    // Умеренно поднимаем контраст и уменьшаем экспозицию без дополнительного render target.
    highp float contrast = 1.0 + 0.34 * amount;
    highp vec3 graded = (original - vec3(0.5)) * contrast + vec3(0.5);
    graded *= mix(1.0, 0.72, amount * (0.45 + 0.55 * shadows));

    // Холодный оттенок появляется преимущественно в тенях, чтобы сохранить цветные источники.
    highp vec3 cold = graded * mix(vec3(1.0), vec3(0.78, 0.86, 0.98), shadows * 0.55 * amount);
    highp float gray = luminance(cold);
    highp float saturation = 1.0 - 0.24 * amount * (0.35 + 0.65 * shadows);
    highp vec3 toned = mix(vec3(gray), cold, clamp(saturation, 0.0, 1.0));

    // Не глушим эмиссивные участки полностью: Bloom и лампы должны оставаться акцентами.
    toned = mix(toned, original, highlights * 0.35 * amount);

    // Мягкая виньетка усиливает ощущение закрытого помещения и не требует отдельной текстуры.
    highp float edge = length((UV - vec2(0.5)) * vec2(1.15, 1.0));
    highp float vignette = smoothstep(0.42, 0.92, edge);
    toned *= 1.0 - 0.22 * amount * vignette;

    COLOR = vec4(clamp(toned, vec3(0.0), vec3(1.0)), source.a);
}
