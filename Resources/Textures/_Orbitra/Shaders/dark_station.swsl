light_mode unshaded;
blend_mode none;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

highp float luminance(highp vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void fragment() {
    lowp vec4 source = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float amount = clamp(strength, 0.0, 1.0);
    // Ползунок управляет мягкостью тонировки: даже максимум не превращает сцену в фильтр.
    highp float mood = amount * 0.55;
    highp vec3 original = max(source.rgb, vec3(0.0));
    highp float brightness = luminance(original);

    // Затемняем в основном средние и тёмные тона, не меняя белые источники света.
    highp float shadows = 1.0 - smoothstep(0.12, 0.78, brightness);
    highp float highlights = smoothstep(0.60, 0.90, brightness);

    // Лёгкий контраст и затемнение сохраняют детали в помещениях без дополнительного render target.
    highp float contrast = 1.0 + 0.14 * mood;
    highp vec3 graded = (original - vec3(0.5)) * contrast + vec3(0.5);
    graded *= mix(1.0, 0.88, shadows * mood);

    // Холодный серо-синий оттенок появляется только в тенях и остаётся почти незаметным.
    highp vec3 cold = graded * mix(vec3(1.0), vec3(0.90, 0.95, 1.0), shadows * mood);
    highp float gray = luminance(cold);
    highp float saturation = 1.0 - 0.10 * mood * (0.35 + 0.65 * shadows);
    highp vec3 toned = mix(vec3(gray), cold, clamp(saturation, 0.0, 1.0));

    // Эмиссивные участки почти сохраняют исходный цвет: Bloom и лампы остаются акцентами.
    toned = mix(toned, original, highlights * 0.80 * mood);

    // Едва заметная виньетка добавляет глубины и не требует отдельной текстуры.
    highp float edge = length((UV - vec2(0.5)) * vec2(1.15, 1.0));
    highp float vignette = smoothstep(0.48, 0.95, edge);
    toned *= 1.0 - 0.10 * mood * vignette;

    COLOR = vec4(clamp(toned, vec3(0.0), vec3(1.0)), source.a);
}
