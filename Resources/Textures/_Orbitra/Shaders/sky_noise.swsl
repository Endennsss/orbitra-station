highp float hashCell(highp vec2 p) {
    highp vec3 v = fract(vec3(p.x, p.y, p.x) * vec3(0.1031, 0.11369, 0.13787));
    v += dot(v, v.yzx + 19.19);
    return fract((v.x + v.y) * v.z);
}

highp float valueNoise(highp vec2 p) {
    highp vec2 cell = floor(p);
    highp vec2 within = fract(p);
    highp vec2 blend = within * within * (3.0 - 2.0 * within);
    return mix(
        mix(hashCell(cell), hashCell(cell + vec2(1.0, 0.0)), blend.x),
        mix(hashCell(cell + vec2(0.0, 1.0)), hashCell(cell + vec2(1.0, 1.0)), blend.x),
        blend.y);
}

highp vec2 rotateSky(highp vec2 p, highp float angle) {
    highp float cosine = cos(angle);
    highp float sine = sin(angle);
    return vec2(cosine * p.x - sine * p.y, sine * p.x + cosine * p.y);
}

highp vec3 starLayer(highp vec2 p, highp float density, highp float pixel, highp float gain) {
    highp vec2 scaled = p * density;
    highp vec2 cell = floor(scaled);
    highp float seed = hashCell(cell);
    if (seed < 0.68) {
        return vec3(0.0);
    }

    highp vec2 offset = vec2(hashCell(cell + 16.2), hashCell(cell - 41.7));
    highp vec2 local = fract(scaled) - (0.23 + offset * 0.54);
    highp float strength = hashCell(cell + 57.3);
    highp float radius = 0.018 + 0.055 * strength * strength;
    highp float fade = clamp(pixel * density * 0.62, 0.015, 0.19);
    highp float core = 1.0 - smoothstep(max(0.0, radius - fade), radius + fade, length(local));
    highp float light = core * (0.018 + 0.44 * strength * strength * strength) * gain;
    highp vec3 color = mix(vec3(0.49, 0.72, 1.0), vec3(1.0, 0.80, 0.58), offset.x * offset.x);
    return color * light;
}
