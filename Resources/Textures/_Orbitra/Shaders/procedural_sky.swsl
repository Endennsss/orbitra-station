light_mode unshaded;

uniform highp vec2 viewport_size;
uniform highp vec2 camera_drift;
uniform highp float camera_rotation;
uniform highp float phase_time;
uniform bool menu_background;
uniform bool docking_background;
uniform bool low_quality;
uniform highp float warp_speed;
uniform highp float warp_distance;

#include "/Textures/_Orbitra/Shaders/sky_noise.swsl"

highp vec3 warpStars(highp vec2 view, highp vec2 density, highp float pixel, highp float speed, highp float gain) {
    highp vec2 scaled = view * density;
    highp vec2 cell = floor(scaled);
    highp float seed = hashCell(cell);
    if (seed < 0.55) {
        return vec3(0.0);
    }

    highp float strength = hashCell(cell + 57.3);
    highp vec2 offset = vec2(hashCell(cell + 16.2), hashCell(cell - 41.7));
    highp vec2 local = fract(scaled) - (vec2(0.19, 0.16) + offset * vec2(0.62, 0.33));
    // Шлейфы затухают до края ячейки, поэтому при прокрутке их край не обрезается.
    highp float trailLength = (0.023 + 0.43 * speed * speed) * mix(0.36, 1.0, strength);
    highp float trail = smoothstep(-pixel * density.y, 0.0, local.y) *
        (1.0 - smoothstep(0.0, trailLength, local.y));
    highp float width = mix(0.008, 0.046, strength * strength);
    highp float fade = min(pixel * density.x * 0.7, 0.14);
    highp float core = 1.0 - smoothstep(max(0.0, width - fade), width + fade, abs(local.x));
    highp vec3 color = mix(vec3(0.52, 0.70, 1.0), vec3(0.95, 0.83, 0.65), offset.x * offset.x);
    return color * trail * core * (0.035 + 0.32 * strength * strength) * gain;
}

highp vec2 nebulaCoordinates(highp vec2 sky) {
    return vec2(sky.x + sky.y * 0.65, sky.y * 1.7 - sky.x * 0.24) * 3.8;
}

highp vec3 backgroundLight(highp vec2 sky, highp float pixel) {
    // В БСС курс проходит вдоль оси Y. Дальние облака прокручиваются медленнее ближних.
    highp vec2 travel = vec2(0.0, warp_distance);
    highp vec2 dust = nebulaCoordinates(sky);
    highp vec2 dustTravel = nebulaCoordinates(travel);
    highp vec2 dustDrift = nebulaCoordinates(camera_drift);
    highp vec2 distantDust = dust + dustTravel * 0.24 + dustDrift * 0.025;
    highp vec2 nearbyDust = dust + dustTravel * 0.43 + dustDrift * 0.055;
    highp float structure = valueNoise(distantDust) * 0.72 + valueNoise(nearbyDust * 2.7 + 19.4) * 0.28;
    if (!low_quality) {
        structure = structure * 0.83 + valueNoise(nearbyDust * 6.2 - 7.3) * 0.17;
    }
    highp float wisps = smoothstep(0.37, 0.84, structure);
    highp float tint = valueNoise(distantDust * 0.64 + 8.9);
    highp vec3 gas = mix(vec3(0.004, 0.018, 0.031), vec3(0.018, 0.008, 0.031), tint);
    highp vec3 result = vec3(0.0014, 0.0021, 0.0042) + gas * wisps;
    highp vec2 menuDrift = menu_background ? vec2(0.025, -0.012) * sin(phase_time * 0.035) : vec2(0.0);
    highp vec3 stars = starLayer(sky + travel * 0.60 + camera_drift * 0.085 + menuDrift, 155.0, pixel, 0.33);
    stars += starLayer(sky + travel + camera_drift * 0.21 + menuDrift * 2.0 + 17.0, 66.0, pixel, 1.0);

    if (warp_speed > 0.001) {
        highp vec3 streaks = warpStars(sky + travel + vec2(17.0, 0.0), vec2(48.0, 4.2), pixel, warp_speed, 0.8);
        if (!low_quality) {
            streaks += warpStars(sky + travel * 0.60, vec2(88.0, 10.0), pixel, warp_speed, 0.22);
        }
        highp float amount = smoothstep(0.0, 0.80, warp_speed);
        stars = mix(stars, stars * 0.20 + streaks, amount);
    }
    result += stars;
    return result;
}

// Расстояния заданы в долях высоты окна: звёзды сохраняют форму на широком экране.
highp float beaconLight(highp vec2 delta, highp float size, highp float pixel) {
    highp vec2 d = abs(delta) / size;
    highp float core = 1.0 - smoothstep(0.0007, 0.0017 + pixel / size, length(d));
    highp float halo = 0.058 * exp(-length(d) * 220.0);
    if (low_quality) {
        return core + halo;
    }
    highp float rays = exp(-(d.x * 130.0 + d.y * 1900.0)) +
                       exp(-(d.x * 1900.0 + d.y * 180.0));
    return core + halo + 0.26 * rays;
}

highp vec3 dockingLight(highp vec2 view, highp float pixel) {
    highp vec2 drift = vec2(0.16 * sin(phase_time * 0.01125), -0.08 * sin(phase_time * 0.005625));
    highp vec2 dust = view + drift * 0.22;
    highp vec2 p = nebulaCoordinates(dust);
    highp float folds = valueNoise(p * 1.6 + 12.3);
    highp float grain = valueNoise(p * 4.2 + folds * 1.45);
    if (!low_quality) {
        grain = mix(grain, valueNoise(p * 11.0 + grain * 2.3), 0.24);
    }
    highp float latitude = dust.y + dust.x * 0.30 + (folds - 0.5) * 0.14;
    highp float ribbon = exp(-abs(latitude) * 10.0);
    highp float light = ribbon * smoothstep(0.25, 0.82, folds * 0.46 + grain * 0.54);
    highp vec3 tint = mix(vec3(0.023, 0.067, 0.112), vec3(0.079, 0.040, 0.096), folds);
    highp vec3 sky = vec3(0.0016, 0.0025, 0.0050) + tint * light;
    sky += starLayer(view + drift * 0.5, 110.0, pixel, 0.44);
    highp vec2 nearSky = view + drift * 1.6;
    sky += starLayer(nearSky + 17.0, 43.0, pixel, 1.25);
    sky += vec3(0.62, 0.80, 1.0) * beaconLight(nearSky - vec2(-0.53, 0.13), 1.45, pixel);
    sky += vec3(0.89, 0.79, 1.0) * beaconLight(nearSky - vec2(0.40, -0.095), 1.1, pixel);
    sky += vec3(0.61, 0.78, 1.0) * beaconLight(nearSky - vec2(0.68, -0.21), 0.72, pixel);
    return sky;
}

void fragment() {
    highp vec2 uv = FRAGCOORD.xy / viewport_size;
    if (menu_background) {
        uv = UV2;
    }
    highp float aspect = viewport_size.x / viewport_size.y;
    highp float pixel = 1.0 / viewport_size.y;
    highp vec2 view = (uv - 0.5) * vec2(aspect, 1.0);
    highp vec2 world = rotateSky(view, -camera_rotation);
    highp vec3 result = docking_background ? dockingLight(view, pixel) : backgroundLight(world, pixel);
    COLOR = vec4(clamp(result, vec3(0.0), vec3(1.0)), 1.0);
}
