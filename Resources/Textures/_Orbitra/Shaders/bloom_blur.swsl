light_mode unshaded;
blend_mode none;

uniform highp vec2 uv_radius;
uniform highp vec2 atlas_grid;
uniform mediump int tap_pairs;

void fragment() {
    // Граница проходит между текселями. Половина текселя оставляет обе bilinear-выборки внутри ячейки.
    highp vec2 cell = floor(UV * atlas_grid);
    highp vec2 first = cell / atlas_grid + 0.5 * TEXTURE_PIXEL_SIZE;
    highp vec2 last = (cell + 1.0) / atlas_grid - 0.5 * TEXTURE_PIXEL_SIZE;

    // Интеграл треугольного ядра по линейным отрезкам между отсчётами.
    // Сумма весов равна единице, а крайние точки лежат на одном радиусе для всех качеств.
    highp float spacing = 1.0 / float(tap_pairs);
    highp vec3 glow = zTexture(UV).rgb * (spacing - spacing * spacing / 3.0);
    for (mediump int i = 1; i <= 8; i++) {
        if (i > tap_pairs)
            break;
        highp float t = float(i) * spacing;
        highp float weight = i == tap_pairs ? spacing * spacing / 6.0 : (1.0 - t) * spacing;
        highp vec2 offset = uv_radius * t;
        glow += (zTexture(clamp(UV - offset, first, last)).rgb
               + zTexture(clamp(UV + offset, first, last)).rgb) * weight;
    }
    COLOR = vec4(glow, 1.0);
}
