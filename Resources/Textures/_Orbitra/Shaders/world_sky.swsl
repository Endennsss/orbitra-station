light_mode unshaded;

uniform highp vec2 viewport_size;
uniform highp vec2 camera_drift;
uniform highp float camera_rotation;
uniform highp vec2 map_seed;
uniform highp float warp_speed;
uniform highp float warp_distance;
uniform lowp int sky_layer;
uniform bool low_quality;

#include "/Textures/_Orbitra/Shaders/sky_noise.swsl"

// Координаты выражены в высотах экрана. При 1080p десять метров дают 12 пикселей для ближних звёзд и 2,5 для пыли.
highp vec2 skyPosition(highp vec2 view, highp float depth, highp float travel) {
    return view + camera_drift * depth + vec2(0.0, warp_distance * travel);
}

highp float dustLane(highp vec2 p) {
    highp vec2 lane = rotateSky(p, (map_seed.x - 0.5) * 1.88);
    highp float bend = 0.10 * sin(3.3 * lane.x + map_seed.y * 6.28);
    highp float latitude = sin(lane.y + bend + (map_seed.y - 0.5) * 0.38);
    highp float band = 1.0 - smoothstep(0.025, 0.34, abs(latitude));
    if (band <= 0.0)
        return 0.0;

    highp vec2 field = lane * vec2(3.2, 7.5) + map_seed * 33.0;
    highp float folds = valueNoise(field);
    highp float grain = folds;
    if (!low_quality) {
        highp float wisps = valueNoise(field * 3.85 + folds * 2.4);
        highp float knots = valueNoise(field * 13.1 + vec2(folds, wisps) * 2.1);
        grain = 0.48 * folds + 0.32 * wisps + 0.20 * knots;
    }

    highp float rift = abs(latitude - 0.018 + 0.115 * (folds - 0.5));
    return band * smoothstep(0.29, 0.84, grain) * (0.19 + 0.81 * smoothstep(0.005, 0.061, rift));
}

// Далёкая россыпь. Фильтруем площадь звезды по размеру пикселя, чтобы движение не гасило её между кадрами.
highp vec3 fineStars(highp vec2 p, highp float density, highp float pixel, highp float glow) {
    highp vec2 grid = p * density;
    highp vec2 cell = floor(grid);
    highp float magnitude = hashCell(cell + 3.3);
    if (magnitude < 0.60)
        return vec3(0.0);

    highp vec2 offset = vec2(hashCell(cell + 7.1), hashCell(cell - 18.2));
    highp vec2 center = 0.20 + offset * 0.58;
    highp vec2 d = fract(grid) - center;
    highp float power = (magnitude - 0.60) * 2.5;
    highp float radius = 0.019 + 0.055 * power * power;
    highp float area = radius * radius;
    highp float width = area + pixel * pixel * density * density * 0.27;
    highp float trail = warp_speed * warp_speed * (0.08 + 0.11 * power);
    if (trail > 0.0)
        d.y -= clamp(d.y, 0.0, min(trail, max(0.0, 1.0 - center.y - sqrt(3.0 * width))));
    highp float profile = max(0.0, 1.0 - dot(d, d) / (3.0 * width));
    highp vec3 tint = mix(vec3(0.55, 0.72, 1.0), vec3(1.0, 0.79, 0.57), offset.x * offset.x);
    return tint * (profile * profile * area / width) * (0.030 + 0.39 * power * power) * glow;
}

highp vec3 nearbyStars(highp vec2 p, highp float pixel) {
    highp vec2 grid = p * 8.2;
    highp vec2 cell = floor(grid);
    highp float magnitude = hashCell(cell - 4.7);
    if (magnitude < (sky_layer == 2 ? 0.92 : 0.62))
        return vec3(0.0);

    highp vec2 offset = vec2(hashCell(cell + 26.1), hashCell(cell - 18.9));
    highp vec2 center = 0.24 + offset * 0.49;
    highp vec2 d = fract(grid) - center;
    highp float power = smoothstep(0.62, 1.0, magnitude);
    highp float trail = warp_speed * warp_speed * (0.04 + 0.16 * power);
    // Даже у края ячейки за шлейфом остаётся место для полного затухания ореола.
    highp float tail = clamp(d.y, 0.0, min(trail, 0.82 - center.y));
    d.y -= tail;
    highp float r2 = dot(d, d);
    if (r2 >= 0.035)
        return vec3(0.0);

    highp float radius = 0.004 + 0.009 * power * power;
    highp float area = radius * radius;
    highp float width = area + pixel * pixel * 17.0;
    highp float warmth = clamp(offset.y + 0.26 * (map_seed.x - 0.5), 0.0, 1.0);
    highp vec3 tint = mix(vec3(0.37, 0.61, 1.0), vec3(1.0, 0.65, 0.36), warmth * warmth);
    highp float core = exp(-r2 / width) * area / width;
    highp float r = sqrt(r2);
    highp float halo = exp(-r / (0.009 + 0.017 * power)) * (0.034 + 0.15 * power * power);
    highp vec3 star = mix(tint, vec3(1.0), 0.62) * core * (0.30 + 0.79 * power) + tint * halo;
    if (!low_quality && magnitude > 0.968) {
        highp vec2 ray = abs(rotateSky(d, 0.21));
        highp float blur = max(0.0027, pixel * 3.7);
        star += tint * 0.16 * (exp(-ray.x / 0.041 - ray.y / blur) + exp(-ray.y / 0.030 - ray.x / blur));
    } else if (offset.x > 0.85) {
        highp vec2 secondary = d - vec2(0.048, (offset.y - 0.5) * 0.078);
        star += mix(vec3(0.68, 0.77, 1.0), tint, 0.4) * 0.43 * area / width * exp(-dot(secondary, secondary) / width);
    }
    return star * (1.0 - smoothstep(0.13, 0.18, r)) * exp(-tail * 11.0);
}

void fragment() {
    highp vec2 view = (FRAGCOORD.xy - 0.5 * viewport_size) / viewport_size.y;
    view = rotateSky(view, -camera_rotation);
    highp float pixel = 1.0 / viewport_size.y;
    highp vec2 offset = map_seed * 27.0;
    highp vec3 light = vec3(0.0);
    if (sky_layer != 3)
        light = nearbyStars(skyPosition(view, 0.00110, 1.0) + offset, pixel);

    if (sky_layer != 2 && sky_layer != 4) {
        highp float lane = dustLane(skyPosition(view, 0.00023, 0.17));
        highp vec2 mid = skyPosition(view, 0.00054, 0.53);
        light += fineStars(mid - offset, 52.0, pixel, 0.44 + 1.05 * lane);
        if (!low_quality)
            light += fineStars(skyPosition(view, 0.00032, 0.31) + offset + 9.8, 112.0, pixel, 0.06 + 2.75 * lane);

        if (sky_layer == 0) {
            highp vec3 dust = mix(vec3(0.024, 0.044, 0.074), vec3(0.066, 0.042, 0.052), map_seed.x);
            light += vec3(0.0017, 0.0025, 0.0053) + dust * lane;
        }
    }

    // На авторской карте пустые пиксели пропускают исходную текстуру туманности.
    highp float alpha = sky_layer == 0 ? 1.0 : clamp(max(max(light.r, light.g), light.b), 0.0, 1.0);
    COLOR = vec4(clamp(light / max(alpha, 0.00001), vec3(0.0), vec3(1.0)), alpha);
}
