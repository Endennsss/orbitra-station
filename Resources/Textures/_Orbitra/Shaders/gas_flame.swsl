light_mode unshaded;

uniform sampler2D previous_fire;
uniform highp vec2 fire_origin;
uniform highp vec2 fire_size;
uniform highp float transition;
uniform bool reduced_motion;

highp float flame_hash(highp vec2 cell) {
    highp vec3 p = fract(cell.xyx * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

highp float flame_noise(highp vec2 p) {
    highp vec2 cell = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(flame_hash(cell), flame_hash(cell + vec2(1.0, 0.0)), f.x),
        mix(flame_hash(cell + vec2(0.0, 1.0)), flame_hash(cell + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
    // Общая сетка грида держит пиксели на месте при движении камеры и на стыках чанков.
    const highp float pixels_per_tile = 16.0;
    highp vec2 p = fire_origin + UV * fire_size;
    p = (floor(p * pixels_per_tile) + 0.5) / pixels_per_tile;
    highp vec2 field_uv = (p - fire_origin) / fire_size;
    highp vec2 uv = mix(TEXTURE_PIXEL_SIZE, vec2(1.0) - TEXTURE_PIXEL_SIZE, field_uv);
    highp vec4 fire = mix(zTextureSpec(previous_fire, uv), zTexture(uv), transition);
    COLOR = vec4(0.0);
    if (fire.a > 0.001) {
        highp vec3 properties = fire.rgb / fire.a;
        highp vec2 flow = clamp(properties.gb * 2.0 - 1.0, vec2(-1.0), vec2(1.0));
        highp float time = reduced_motion ? 0.0 : TIME;

        // Широкие восходящие волны изгибают мелкие языки в координатах грида.
        highp vec2 lift = vec2(0.0, time);
        highp float billow = flame_noise(p * vec2(0.93, 0.67) - lift * 0.78);
        highp float shear = flame_noise(p * vec2(1.27, 1.08) - lift * 1.51 + vec2(8.2, 3.1));
        highp vec2 rising = p - vec2(0.0, time * 1.55);
        rising += vec2((billow - 0.5) * 0.67, (shear - 0.5) * 0.53);
        rising -= flow * (0.25 + 0.52 * shear);
        highp float tongues = flame_noise(rising * vec2(3.8, 1.36));
        highp float detail = flame_noise(rising * vec2(7.8, 2.9) + vec2(5.2, 2.3));

        highp float heat = tongues * 0.54 + billow * 0.29 + detail * 0.17;
        heat += 0.23 * sqrt(fire.a);
        highp float skirt = step(0.47, heat);
        highp float body = step(0.58, heat);
        highp float hot = step(0.72, heat);
        highp float core = step(0.85, heat);
        highp float gas = smoothstep(0.025, 0.14, properties.r);
        highp float tritium = smoothstep(0.14, 1.0, properties.r);
        highp vec3 rim = mix(vec3(0.70, 0.15, 0.047),
            mix(vec3(0.68, 0.13, 0.34), vec3(0.65, 0.45, 0.15), tritium), gas * 0.55);
        highp vec3 color = mix(rim, vec3(0.98, 0.35, 0.063), body);
        color = mix(color, vec3(1.0, 0.66, 0.15), hot);
        color = mix(color, vec3(1.0, 0.89, 0.48), core);
        highp float coverage = fire.a * (0.27 * skirt + 0.42 * body + 0.16 * hot + 0.12 * core);
        COLOR = zFromSrgb(vec4(color, coverage));
    }
}
