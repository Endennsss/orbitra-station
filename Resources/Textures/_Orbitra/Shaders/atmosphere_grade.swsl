light_mode unshaded;
blend_mode none;

uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D WORLD_LIGHT;
uniform sampler2D GRID_MASK;

void fragment() {
    highp vec4 scene = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float inside = zTextureSpec(GRID_MASK, UV).a;
    COLOR = scene;
    if (inside > 0.0) {
        highp vec3 light = zTextureSpec(WORLD_LIGHT, UV).rgb;
        highp float strongest = max(light.r, max(light.g, light.b));
        highp float brightness = dot(scene.rgb, vec3(0.2126, 0.7152, 0.0722));
        highp float lit = smoothstep(0.15, 0.50, strongest);
        highp float red_light = smoothstep(0.025, 0.26, light.r - max(light.g, light.b));

        // Освещённые поверхности сохраняют цвет, в тени насыщенность падает без затемнения деталей.
        highp vec3 shadow = mix(vec3(brightness), scene.rgb, mix(0.57, 0.84, red_light));
        shadow *= vec3(0.99, 1.01, 1.035);
        highp vec3 daylight = scene.rgb * vec3(1.065, 1.045, 1.015);
        daylight += scene.rgb * (vec3(1.0) - scene.rgb) * 0.16;
        highp vec3 grade = mix(shadow, daylight, lit);

        // Красный акцент остаётся в пятне света и гаснет на уже ярких спрайтах.
        highp float accent = red_light * brightness * (1.0 - smoothstep(0.25, 0.80, brightness));
        grade += vec3(0.20, 0.022, 0.008) * accent;
        COLOR = vec4(mix(scene.rgb, clamp(grade, vec3(0.0), vec3(1.0)), inside), scene.a);
    }
}
