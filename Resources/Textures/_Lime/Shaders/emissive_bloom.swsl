light_mode unshaded;
blend_mode add;

uniform mediump float bloom_strength;

void fragment() {
    lowp vec4 glow = zTexture(UV);
    mediump float energy = max(glow.r, max(glow.g, glow.b));
    if (energy <= 0.001)
        discard;

    // Энергия уже содержит прозрачность источника. Повторное умножение уничтожает мягкий край.
    COLOR = vec4(max(glow.rgb, vec3(0.0)) * bloom_strength, 1.0);
}
